<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Coprifuoco" Width="400" Height="244" WindowStyle="None" ResizeMode="NoResize" Topmost="True"
        ShowInTaskbar="False" Background="#2A2622" BorderBrush="#BE9561" BorderThickness="2"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14" UseLayoutRounding="True">
  <Window.Resources>
    <Style x:Key="Soft" TargetType="Button">
      <Setter Property="Foreground" Value="#E6DCCA"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="#342F29" BorderBrush="#5A5246" BorderThickness="1" CornerRadius="2" Padding="14,9">
              <ContentPresenter HorizontalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#3E382F"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="#E6DCCA"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Main" TargetType="Button" BasedOn="{StaticResource Soft}">
      <Setter Property="Foreground" Value="#1E1B17"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="#BE9561" BorderBrush="Transparent" BorderThickness="1" CornerRadius="2" Padding="14,9">
              <ContentPresenter HorizontalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.88"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="#E6DCCA"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <StackPanel Margin="20,16,20,16">
    <TextBlock x:Name="Head" Text="" FontSize="17" FontWeight="SemiBold" Foreground="#E6DCCA" TextWrapping="Wrap"/>
    <TextBlock x:Name="Body" Text="" Foreground="#E6DCCA" TextWrapping="Wrap" Margin="0,8,0,6"/>
    <TextBlock Text="Se non premi niente, resta valido." Foreground="#A39985" FontSize="12" Margin="0,0,0,14"/>
    <UniformGrid Columns="2">
      <Button x:Name="Keep" Style="{StaticResource Main}" Content="Sì, tienilo valido" Margin="0,0,6,0"/>
      <Button x:Name="Cancel" Style="{StaticResource Soft}" Content="No, annulla"/>
    </UniformGrid>
  </StackPanel>
</Window>
