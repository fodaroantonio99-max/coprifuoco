<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Coprifuoco" Width="390" Height="256" WindowStyle="None" ResizeMode="NoResize" Topmost="True"
        ShowInTaskbar="False" Background="#2A2622" BorderBrush="#BE9561" BorderThickness="2"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14" UseLayoutRounding="True">
  <Window.Resources>
    <Style x:Key="Soft" TargetType="Button">
      <Setter Property="Foreground" Value="#E6DCCA"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="#342F29" BorderBrush="#5A5246" BorderThickness="1" CornerRadius="2" Padding="6,7">
              <ContentPresenter HorizontalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#3E382F"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="#E6DCCA"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Main" TargetType="Button" BasedOn="{StaticResource Soft}">
      <Setter Property="Foreground" Value="#1E1B17"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="#BE9561" BorderBrush="Transparent" BorderThickness="1" CornerRadius="2" Padding="14,9">
              <ContentPresenter HorizontalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.88"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="#E6DCCA"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <StackPanel Margin="20,16,20,16">
    <TextBlock x:Name="Head" Text="" FontSize="17" FontWeight="SemiBold" Foreground="#E6DCCA" TextWrapping="Wrap"/>
    <TextBlock x:Name="Left" Text="00:05:00" FontFamily="Consolas" FontSize="34" Foreground="#D07A6A" Margin="0,6,0,2" AutomationProperties.LiveSetting="Assertive"/>
    <TextBlock Text="Se non premi niente, parto comunque all'ora prevista." Foreground="#A39985" TextWrapping="Wrap" Margin="0,0,0,12"/>
    <Button x:Name="Ok" Style="{StaticResource Main}" Content="Va bene, procedi"/>
    <TextBlock Text="Rimanda di" Foreground="#A39985" FontSize="12" Margin="0,12,0,4"/>
    <UniformGrid Columns="3">
      <Button x:Name="P30" Style="{StaticResource Soft}" Tag="30" Content="30 minuti" Margin="0,0,6,0"/>
      <Button x:Name="P60" Style="{StaticResource Soft}" Tag="60" Content="1 ora" Margin="0,0,6,0"/>
      <Button x:Name="P240" Style="{StaticResource Soft}" Tag="240" Content="4 ore"/>
    </UniformGrid>
  </StackPanel>
</Window>
